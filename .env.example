# Copy to .env for local development. Safe defaults; no secrets here.
DTQ_REDIS_URL=redis://localhost:6379/0
DTQ_API_HOST=0.0.0.0
DTQ_API_PORT=8000
DTQ_WS_PATH=/ws/events
DTQ_WORKER_CONCURRENCY=4
DTQ_WORKER_METRICS_PORT=8001
DTQ_VISIBILITY_TIMEOUT_S=30
DTQ_HEARTBEAT_INTERVAL_S=5
DTQ_MAX_QUEUE_DEPTH=10000
DTQ_MAX_PAYLOAD_BYTES=262144
DTQ_TASK_TIMEOUT_MS=30000
DTQ_MAX_ATTEMPTS=10
DTQ_RETRY_BASE_DELAY=1.0
DTQ_RETRY_MAX_DELAY=60.0
DTQ_RETRY_JITTER=0.2
DTQ_TASK_RETENTION_S=604800
DTQ_RESULT_RETENTION_S=3600
DTQ_RESULT_MAX_BYTES=8192
DTQ_IDEM_TTL_S=86400
DTQ_DRAIN_TIMEOUT_S=30
DTQ_DLQ_ENABLED=true
DTQ_DLQ_MAXLEN=10000
DTQ_API_KEY=
DTQ_TASK_MODULES=
DTQ_LOG_LEVEL=INFO
DTQ_LOG_JSON=false
