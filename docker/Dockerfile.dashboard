# DTQ dashboard image: Vite build, served by nginx as a non-root user.
FROM node:24-alpine AS build

WORKDIR /app/apps/dashboard
COPY apps/dashboard/package.json apps/dashboard/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY apps/dashboard/ ./
RUN npm run build

FROM nginx:alpine

# Non-root: nginx runs as the nginx user and listens on 8080 (unprivileged).
RUN rm /etc/nginx/conf.d/default.conf
COPY docker/nginx.conf /etc/nginx/conf.d/dtq.conf
COPY --from=build --chown=nginx:nginx /app/apps/dashboard/dist /usr/share/nginx/html
RUN touch /var/run/nginx.pid && chown nginx:nginx /var/run/nginx.pid \
    && mkdir -p /var/cache/nginx /var/log/nginx && chown -R nginx:nginx /var/cache/nginx /var/log/nginx

USER nginx
EXPOSE 8080
CMD ["nginx", "-g", "daemon off;"]
